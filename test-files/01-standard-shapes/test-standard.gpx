<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="OpenMapEditor Test" xmlns="http://www.topografix.com/GPX/1/1" xmlns:gpx_style="http://www.topografix.com/GPX/gpx_style/0/2">
  <wpt lat="52.5200" lon="13.4050">
    <name>Test Point</name>
    <desc>A test point in Berlin</desc>
    <extensions>
      <gpx_style:color>E51B23</gpx_style:color>
    </extensions>
  </wpt>
  <trk>
    <name>Test LineString</name>
    <desc>A test linestring from Berlin to Munich</desc>
    <extensions>
      <gpx_style:color>0066CC</gpx_style:color>
    </extensions>
    <trkseg>
      <trkpt lat="52.5200" lon="13.4050"/>
      <trkpt lat="48.1351" lon="11.5820"/>
    </trkseg>
  </trk>
  <trk>
    <name>Test Polygon</name>
    <desc>A test polygon in Bavaria</desc>
    <extensions>
      <gpx_style:color>3C8C3C</gpx_style:color>
    </extensions>
    <trkseg>
      <trkpt lat="48.0" lon="11.0"/>
      <trkpt lat="48.0" lon="12.0"/>
      <trkpt lat="49.0" lon="11.5"/>
      <trkpt lat="48.0" lon="11.0"/>
    </trkseg>
  </trk>
</gpx>
